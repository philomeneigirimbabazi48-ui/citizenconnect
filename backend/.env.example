# ============================================
# CitizenConnect Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB - Use MongoDB Atlas (free) or local
MONGODB_URI=mongodb://localhost:27017/citizenconnect
# For Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/citizenconnect

# JWT Secret - change this to a long random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Anthropic AI (for leader AI response suggestions)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email (Nodemailer - optional, for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# File uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
